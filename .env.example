# Copy to .env and fill in. Never commit .env.

# Token from @BotFather (/mybots → bot → API Token)
BOT_TOKEN=

# AI model via an OpenAI-compatible API (Гидра / OpenRouter / Hermes / direct)
AI_BASE_URL=https://api.hydraai.ru/v1
AI_API_KEY=
# The model must understand images
AI_MODEL=gemini-3.1-pro

# Speech to text: deepgram | api (Whisper via the AI provider) | local (faster-whisper) | off
WHISPER_MODE=api
WHISPER_MODEL=whisper-1
# Leave empty to use AI_BASE_URL / AI_API_KEY
WHISPER_BASE_URL=
WHISPER_API_KEY=

# Deepgram speech-to-text (WHISPER_MODE=deepgram)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Reactions: draft and "create now"
EMOJI_DRAFT=✍
EMOJI_NOW=⚡
AUTO_CREATE_SECONDS=60
BUFFER_DAYS=14

# Auto mode (/auto on in a chat): look for tasks after this many seconds of silence
AUTO_PAUSE_SECONDS=120
AUTO_MAX_BATCH=150

# Mini app server (the HTTPS tunnel or the domain points here)
WEB_HOST=0.0.0.0
WEB_PORT=8787
# HTTPS address of the mini app, e.g. https://checklists.example.com
PUBLIC_URL=
# Link used by «✏️ Открыть». Main Mini App of the bot:
MINIAPP_LINK=https://t.me/{bot}?startapp={param}

TZ=Europe/Moscow
LOG_LEVEL=INFO

# Token for AI agents (MCP server). Full access to all projects. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Optional closed alpha for a hosted instance. Self-hosted installations are open by default.
CLOSED_ALPHA=0
ADMIN_ID=
